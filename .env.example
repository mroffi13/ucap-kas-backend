# Environment variables for ucapkas_backend (Modul 1)
APP_ENV=development
PORT=8080
DATABASE_URL=postgres://ucapkas:ucapkas_local_dev_pw@127.0.0.1:5432/ucapkas?sslmode=disable

# Minimum 32 random bytes! Generate in production with: openssl rand -hex 32
JWT_SECRET=change_me_in_production_minimum_32_chars_long_9f8e7d6c5b4a

# Comma-separated OAuth 2.0 Client IDs from Google Cloud Console (iOS, Android, Web)
GOOGLE_CLIENT_IDS=your-ios-client-id.apps.googleusercontent.com,your-android-client-id.apps.googleusercontent.com,your-web-client-id.apps.googleusercontent.com

# ONLY evaluated when APP_ENV=development. Keep false in production!
ALLOW_DEV_MOCK_AUTH=true
ALLOWED_CORS_ORIGIN=*
